  "recording": {
    "version": "1",
    "site": "http://127.0.0.1",
    "intent": "Walk the community inbox and read each open conversation into a record.",
    "pages": [
      {
        "url": "/",
        "steps": [
          {
            "step": {
              "kind": "navigate",
              "url": "/",
              "expect": {
                "kind": "textIncludes",
                "target": {
                  "role": "heading",
                  "name": "Inbox — open conversations"
                },
                "text": "Inbox"
              }
            },
            "stepId": "s-inbox",
            "objective": "Open the community inbox, the page that lists every open conversation.",
            "expectedResult": "The inbox page is shown with its heading."
          },
          {
            "step": {
              "kind": "forEach",
              "items": {
                "testId": "inbox-row"
              },
              "as": "records",
              "steps": [
                {
                  "kind": "extract",
                  "target": {
                    "testId": "row-meta"
                  },
                  "as": "provider",
                  "attr": "data-provider",
                  "expect": {
                    "kind": "attr",
                    "target": {
                      "testId": "row-meta"
                    },
                    "name": "data-provider"
                  }
                },
                {
                  "kind": "extract",
                  "target": {
                    "testId": "row-meta"
                  },
                  "as": "channel",
                  "attr": "data-channel",
                  "expect": {
                    "kind": "attr",
                    "target": {
                      "testId": "row-meta"
                    },
                    "name": "data-channel"
                  }
                },
                {
                  "kind": "extract",
                  "target": {
                    "testId": "row-meta"
                  },
                  "as": "account",
                  "attr": "data-account",
                  "expect": {
                    "kind": "attr",
                    "target": {
                      "testId": "row-meta"
                    },
                    "name": "data-account"
                  }
                },
                {
                  "kind": "extract",
                  "target": {
                    "testId": "row-meta"
                  },
                  "as": "postId",
                  "attr": "data-post-id",
                  "expect": {
                    "kind": "attr",
                    "target": {
                      "testId": "row-meta"
                    },
                    "name": "data-post-id"
                  }
                },
                {
                  "kind": "extract",
                  "target": {
                    "testId": "row-meta"
                  },
                  "as": "threadId",
                  "attr": "data-thread-id",
                  "expect": {
                    "kind": "attr",
                    "target": {
                      "testId": "row-meta"
                    },
                    "name": "data-thread-id"
                  }
                },
                {
                  "kind": "extract",
                  "target": {
                    "testId": "row-meta"
                  },
                  "as": "commentId",
                  "attr": "data-comment-id",
                  "expect": {
                    "kind": "attr",
                    "target": {
                      "testId": "row-meta"
                    },
                    "name": "data-comment-id"
                  }
                },
                {
                  "kind": "extract",
                  "target": {
                    "testId": "row-meta"
                  },
                  "as": "permalink",
                  "attr": "data-permalink",
                  "expect": {
                    "kind": "attr",
                    "target": {
                      "testId": "row-meta"
                    },
                    "name": "data-permalink"
                  }
                },
                {
                  "kind": "extract",
                  "target": {
                    "testId": "row-text"
                  },
                  "as": "sourceText",
                  "expect": {
                    "kind": "count",
                    "target": {
                      "testId": "row-text"
                    },
                    "min": 1
                  }
                }
              ]
            },
            "stepId": "s-records",
            "objective": "Walk every inbox row and read its record fields: provider, channel, account, post, thread, comment and permalink from the row's data-* attributes, and sourceText from the row's text. parentId is deliberately not extracted here: rows without a parent have no such attribute, so a reply-to-reply Journey declares expected_parentid separately."
          }
        ]
      }
    ]
  }

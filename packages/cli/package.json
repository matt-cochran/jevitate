{
  "name": "@jevitate/cli",
  "version": "0.1.0",
  "description": "Jevitate CLI — author, run, and orchestrate browser-automation Journeys from the command line.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
